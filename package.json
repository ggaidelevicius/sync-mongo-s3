{
  "name": "@ggaidelevicius/sync-mongo-s3",
  "version": "0.1.1",
  "description": "CLI for dumping a remote MongoDB, restoring it locally, and syncing an S3 bucket into ./s3-bucket.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sync-mongo-s3": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc --outDir dist --rootDir src",
    "check": "prettier --check . && pnpm test",
    "format": "prettier --write .",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepack": "pnpm build",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": "^9 || ^10"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggaidelevicius/sync-mongo-s3.git"
  },
  "bugs": {
    "url": "https://github.com/ggaidelevicius/sync-mongo-s3/issues"
  },
  "homepage": "https://github.com/ggaidelevicius/sync-mongo-s3#readme",
  "keywords": [
    "mongodb",
    "mongodump",
    "mongorestore",
    "s3",
    "aws",
    "cli",
    "backup",
    "restore"
  ],
  "author": "Gus Gaidelevicius"
}
